{
  "formId": "mother_survey_v1",
  "title": "Phiếu Khảo Sát Ý Kiến Người Mẹ Sinh Con",
  "version": 1,
  "meta": {
    "description": "Khảo sát trải nghiệm người mẹ sinh con tại bệnh viện",
    "anonymous": true
  },
  "sections": [
    {
      "id": "admin_info",
      "title": "Thông tin hành chính",
      "fields": [
        {
          "id": "hospital_name",
          "label": "Tên bệnh viện",
          "type": "text",
          "required": true
        },
        {
          "id": "survey_date",
          "label": "Ngày điền phiếu",
          "type": "date",
          "required": true
        },
        {
          "id": "departments",
          "label": "Các khoa đã điều trị",
          "type": "textarea"
        },
        {
          "id": "department_code",
          "label": "Mã khoa",
          "type": "text"
        },
        {
          "id": "mother_id",
          "label": "Mã số người mẹ",
          "type": "text"
        }
      ]
    },
    {
      "id": "patient_info",
      "title": "Thông tin người bệnh",
      "fields": [
        {
          "id": "age",
          "label": "Tuổi",
          "type": "number",
          "required": true
        },
        {
          "id": "phone",
          "label": "Số điện thoại",
          "type": "tel"
        },
        {
          "id": "days_in_hospital",
          "label": "Số ngày nằm viện",
          "type": "number"
        },
        {
          "id": "visit_count",
          "label": "Lần nhập viện",
          "type": "number"
        },
        {
          "id": "bhyt",
          "label": "Sử dụng BHYT",
          "type": "radio",
          "options": [
            {
              "value": 1,
              "label": "Có"
            },
            {
              "value": 2,
              "label": "Không"
            }
          ]
        },
        {
          "id": "birth_method",
          "label": "Cách sinh",
          "type": "radio",
          "options": [
            {
              "value": 1,
              "label": "Đẻ thường"
            },
            {
              "value": 2,
              "label": "Mổ cấp cứu"
            },
            {
              "value": 3,
              "label": "Mổ có chuẩn bị"
            },
            {
              "value": 4,
              "label": "Khác",
              "hasInput": true
            }
          ]
        },
        {
          "id": "prenatal_check",
          "label": "Khám thai",
          "type": "radio",
          "options": [
            {
              "value": 1,
              "label": "Có khám",
              "hasInput": true
            },
            {
              "value": 2,
              "label": "Chỉ đến sinh"
            },
            {
              "value": 3,
              "label": "Không nhớ"
            }
          ]
        }
      ]
    },
